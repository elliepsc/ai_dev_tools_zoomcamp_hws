{
  "title": "SecurityAuditFindings",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings"],
  "properties": {
    "summary": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "severity", "category", "file", "line", "evidence", "impact", "recommendation", "confidence"],
        "properties": {
          "id": { "type": "string", "description": "M-01, M-02..." },
          "title": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
          "category": { "type": "string", "enum": ["prompt-injection", "excessive-agency", "secrets", "pii-in-telemetry", "network-exposure", "authn-authz", "supply-chain", "command-injection", "availability", "other"] },
          "file": { "type": "string" },
          "line": { "type": ["integer", "null"] },
          "evidence": { "type": "string", "description": "the exact code or config that supports the finding" },
          "impact": { "type": "string" },
          "recommendation": { "type": "string" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
        }
      }
    }
  }
}
