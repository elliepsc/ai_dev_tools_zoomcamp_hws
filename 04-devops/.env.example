# Copy to .env (git-ignored). Read by docker compose AND by the responder.
# Shared secret: Grafana's webhook sends it as "Authorization: Bearer ...".
RESPONDER_TOKEN=replace-with-a-long-random-string
# Agent used by the responder: claude | codex
RESPONDER_AGENT=claude
# Optional: pin the model (otherwise the CLI default is used and recorded)
# RESPONDER_MODEL=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
